diff --git a/packages/quds_office_editor/example/lib/studio_web_data_store.dart b/packages/quds_office_editor/example/lib/studio_web_data_store.dart
new file mode 100644
index 0000000000000000000000000000000000000000..c22572b6d713a2b5d4e6cabea4386b42f9451d01
--- /dev/null
+++ b/packages/quds_office_editor/example/lib/studio_web_data_store.dart
@@ -0,0 +1,31 @@
+import 'dart:typed_data';
+
+import 'studio_web_data_store_none.dart'
+    if (dart.library.js_interop) 'studio_web_data_store_cache.dart'
+    as platform;
+
+/// Keeps verified proofing downloads (dictionaries, morphology database)
+/// across browser sessions.
+///
+/// The store holds bytes only; it is never trusted. Every read is verified
+/// again by the caller against the same compiled-in SHA-256/length pins the
+/// native installers use, and anything that fails is deleted.
+abstract interface class StudioWebDataStore {
+  /// The stored bytes for [key], or null (also when storage is unavailable).
+  Future<Uint8List?> read(String key);
+
+  /// Stores [bytes]; returns false when the browser refused (quota, private
+  /// mode, insecure origin). The download still works for this session.
+  Future<bool> write(String key, Uint8List bytes);
+
+  Future<void> delete(String key);
+}
+
+/// Cache Storage in browsers; a store that keeps nothing elsewhere.
+StudioWebDataStore createDefaultStudioWebDataStore() =>
+    platform.createDefaultStudioWebDataStore();
+
+/// Status text for data kept in browser storage, with its size.
+String studioWebStoredLocation(int bytes) =>
+    'Stored in this browser (${(bytes / 1048576).toStringAsFixed(1)} MB, '
+    're-verified against its pins on load)';
diff --git a/packages/quds_office_editor/example/lib/studio_web_data_store_cache.dart b/packages/quds_office_editor/example/lib/studio_web_data_store_cache.dart
new file mode 100644
index 0000000000000000000000000000000000000000..43e2c92e8ae51239b7fc1e5e86585678b8cb6fe8
--- /dev/null
+++ b/packages/quds_office_editor/example/lib/studio_web_data_store_cache.dart
@@ -0,0 +1,79 @@
+import 'dart:js_interop';
+import 'dart:typed_data';
+
+import 'package:web/web.dart' as web;
+
+import 'studio_web_data_store.dart';
+
+StudioWebDataStore createDefaultStudioWebDataStore() =>
+    const CacheStorageStudioWebDataStore();
+
+/// [StudioWebDataStore] on the browser's Cache Storage (origin-private,
+/// survives reloads, cleared with the site data). Keys become same-origin
+/// request paths that the app never serves.
+final class CacheStorageStudioWebDataStore implements StudioWebDataStore {
+  const CacheStorageStudioWebDataStore({
+    this.cacheName = 'quds-proofing-data-v1',
+  });
+
+  final String cacheName;
+
+  static String _request(String key) =>
+      '/__quds_proofing_data__/${Uri.encodeComponent(key)}';
+
+  Future<web.Cache?> _open() async {
+    try {
+      return await web.window.caches.open(cacheName).toDart;
+    } on Object {
+      return null;
+    }
+  }
+
+  @override
+  Future<Uint8List?> read(String key) async {
+    final cache = await _open();
+    if (cache == null) return null;
+    try {
+      final found = await cache.match(_request(key).toJS).toDart;
+      if (found == null) return null;
+      final buffer = await found.arrayBuffer().toDart;
+      return buffer.toDart.asUint8List();
+    } on Object {
+      return null;
+    }
+  }
+
+  @override
+  Future<bool> write(String key, Uint8List bytes) async {
+    final cache = await _open();
+    if (cache == null) return false;
+    try {
+      await cache
+          .put(
+            _request(key).toJS,
+            web.Response(
+              bytes.toJS,
+              web.ResponseInit(
+                headers: web.Headers()
+                  ..set('content-type', 'application/octet-stream'),
+              ),
+            ),
+          )
+          .toDart;
+      return true;
+    } on Object {
+      return false;
+    }
+  }
+
+  @override
+  Future<void> delete(String key) async {
+    final cache = await _open();
+    if (cache == null) return;
+    try {
+      await cache.delete(_request(key).toJS).toDart;
+    } on Object {
+      // Nothing stored or storage unavailable.
+    }
+  }
+}
