+    test('lexical matching preserves $mark', () async {
+      final List<OfficeProofingFinding> findings = await check(text);
+      expect(
+        findings.map((f) => '${f.ruleId}:${f.replacements}').toList(),
+        isEmpty,
+      );
+    });
